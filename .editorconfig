root = true

[*.py]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false

